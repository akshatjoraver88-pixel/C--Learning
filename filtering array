#include <stdio.h>
#include <stdlib.h>
int main () {

int number[10] = {10, 3, 56, 24, 34, 67, 92, 8, 73, 45};
int even[10];
int count = 0;
for (int i = 0; i < 10; i++) {
    if (number[i] % 2 == 0) {
        even[count] = number[i];
        count++;
    }
}
for (int i = 0; i < count; i++){
    printf("even: %d\n", even[i]);
}
    return 0;
}
